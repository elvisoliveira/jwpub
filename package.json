{
  "name": "jwpub",
  "private": true,
  "license": "MIT",
  "description": "JWPUB reader in the browser: index.html + jwpub.js, styles.css built from scss/",
  "scripts": {
    "css": "bun --bun sass --load-path=scss --no-source-map --style=compressed scss/main.scss styles.css",
    "css:watch": "bun --bun sass --load-path=scss --no-source-map --watch scss/main.scss styles.css",
    "lint": "bun lint/lint.mjs && bun lint/format.mjs --check",
    "lint:fix": "bun lint/format.mjs"
  },
  "devDependencies": {
    "regex": "^6.1.0",
    "sass": "1.107.1",
    "sass-parser": "^0.5.5"
  }
}
