{
  "name": "jwpub",
  "private": true,
  "description": "JWPUB reader in the browser: index.html + jwpub.js, styles.css built from scss/",
  "scripts": {
    "css": "sass --no-source-map --style=compressed scss/main.scss styles.css",
    "css:watch": "sass --no-source-map --watch scss/main.scss styles.css",
    "lint": "stylelint \"scss/**/*.scss\"",
    "lint:fix": "stylelint \"scss/**/*.scss\" --fix"
  },
  "devDependencies": {
    "@stylistic/stylelint-plugin": "^3",
    "sass": "1.107.1",
    "stylelint": "^16",
    "stylelint-config-standard-scss": "^14"
  }
}
